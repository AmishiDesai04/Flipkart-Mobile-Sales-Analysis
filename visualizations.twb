      <column caption='Price_Status' datatype='string' name='[Calculation_1269170735428673536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([sales_price]) THEN &quot;Missing&quot; ELSE &quot;Present&quot; END' />
      </column>
      <column caption='Rating_Status' datatype='string' name='[Calculation_1269170735428849665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([ratings]) THEN &quot;Missing&quot; ELSE &quot;Present&quot; END' />
      </column>
      <column caption='Value Score' datatype='real' name='[Calculation_1269170735442591746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(([RAM]*10 + [battery_capacity]/100 + [num_front_camera]*2) / [sales_price]) *100' />
      </column>
      <column caption='Model Rank' datatype='integer' name='[Calculation_1269170735459373060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(COUNT([model]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top N Filter' datatype='boolean' name='[Calculation_1269170735461883910]' role='measure' type='nominal'>
